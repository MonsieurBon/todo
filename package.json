{
  "name": "todo",
  "version": "1.0.0-SNAPSHOT",
  "scripts": {
    "ng": "ng",
    "prepare": "npm run api:types",
    "start": "ng serve",
    "api:types": "openapi-typescript src/main/webapp/api/openapi.json -o src/main/webapp/api/schema.d.ts",
    "build": "npm run api:types && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --no-progress",
    "format": "prettier --write src/main/webapp/**/*.{ts,html,scss}",
    "format:check": "prettier --check src/main/webapp/**/*.{ts,html,scss}",
    "lint": "ng lint --fix",
    "lint:check": "ng lint",
    "e2e": "playwright test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/material": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "@angular/service-worker": "22.1.4",
    "angular-oauth2-oidc": "22.0.2",
    "idb": "8.0.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "angular-eslint": "22.2.0",
    "eslint": "10.9.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "28.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "./mvnw -B versions:set -DnewVersion=\"${nextRelease.version}\" -DgenerateBackupPoms=false",
          "publishCmd": "./mvnw -B clean package -DskipTests=true && docker build --tag ghcr.io/monsieurbon/todo:\"${nextRelease.version}\" --tag ghcr.io/monsieurbon/todo:latest . && docker push ghcr.io/monsieurbon/todo:\"${nextRelease.version}\" && docker push ghcr.io/monsieurbon/todo:latest",
          "successCmd": "NEXT_VERSION=$(npm version patch --no-git-tag-version | sed \"s/^v//\")-SNAPSHOT && npm pkg set version=\"$NEXT_VERSION\" && ./mvnw -B versions:set -DnewVersion=\"$NEXT_VERSION\" -DgenerateBackupPoms=false && git commit -am \"chore(release): $NEXT_VERSION [skip ci]\" && git push"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json",
            "CHANGELOG.md",
            "pom.xml"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "target/todo-*.jar",
              "label": "JAR"
            }
          ]
        }
      ]
    ]
  }
}
