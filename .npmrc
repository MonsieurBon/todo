# The automatic audit and funding lookups are network round trips on every single
# install, and on this project they cost about 140 seconds against 1.4 seconds
# without them - a hundredfold, paid by every `mvn test`, `mvn verify` and
# `mvn spring-boot:run`, because the frontend build is wired into the Maven
# lifecycle.
#
# Nothing is lost: `npm audit` reports, it does not fix, and it can still be run
# deliberately. Vulnerability reporting belongs in a scheduled job or Dependabot,
# not in the inner development loop.
audit=false
fund=false
