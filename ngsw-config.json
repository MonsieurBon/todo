{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/media/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "board",
      "urls": ["/api/board", "/api/board?*", "/api/labels", "/api/tasklists"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 40,
        "maxAge": "30d",
        "timeout": "3s"
      }
    }
  ],
  "navigationUrls": ["/**", "!/api/**", "!/mcp/**", "!/actuator/**", "!/v3/**", "!/.well-known/**"]
}
